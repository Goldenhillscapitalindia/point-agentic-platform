# Server-only values. Copy to .env.local for development; set these in Vercel for deployment.
OPENAI_API_KEY=
OPENAI_VECTOR_STORE_ID=vs_6acdd4ab3c448191b81ceb4a5be4be11
# Optional: a separate index for the institutional terminal. Blank uses its website snapshot.
OPENAI_TERMINAL_VECTOR_STORE_ID=
OPENAI_MODEL=gpt-5.4-mini

# Authentication: local development persists accounts in ignored .point-auth/.
# Set BOTH Redis values on Vercel/production. KV_REST_API_URL/TOKEN are also supported.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Optional canonical origin for authentication requests, e.g. https://your-project.vercel.app
POINT_APP_ORIGIN=
# Optional administrator, created only if this email has not already registered.
# Use a unique password of 12–128 characters. Never put it in browser code.
POINT_ADMIN_EMAIL=
POINT_ADMIN_PASSWORD=
POINT_ADMIN_NAME=Point Admin
