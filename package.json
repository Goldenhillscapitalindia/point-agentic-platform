{
  "name": "point-agentic-platform",
  "version": "1.7.0",
  "private": true,
  "description": "Point Agentic Solutions — static marketing site + fund-intelligence platform demo",
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "build": "node build.js",
    "start": "node build.js && node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/dev.cjs",
    "serve": "npx -y serve dist -l 4178",
    "dev": "node build.js && node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/dev.cjs",
    "index:knowledge": "node build-data.js && node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/index-knowledge.cjs",
    "data:tearsheet": "node scripts/fetch-tearsheet-data.cjs && node build.js",
    "data:sentiment": "node scripts/fetch-sentiment.cjs && node build.js"
  },
  "engines": {
    "node": ">=22.9.0"
  }
}
